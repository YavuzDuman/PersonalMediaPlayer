<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PersonalMediaPlayer.App.Views.ScreenshotOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="Root"
        Background="Black"
        PointerMoved="Root_PointerMoved"
        PointerPressed="Root_PointerPressed"
        PointerReleased="Root_PointerReleased">
        <Image x:Name="BackgroundImage" Stretch="Fill" />
        <Border Background="#66000000" IsHitTestVisible="False" />
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Rectangle
                x:Name="SelectionRect"
                Fill="#22FFFFFF"
                Stroke="#FF4CC2FF"
                StrokeThickness="2"
                Visibility="Collapsed" />
        </Canvas>
        <TextBlock
            x:Name="HintText"
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="White"
            IsHitTestVisible="False"
            Text="Esc or Alt+F4 cancels." />
    </Grid>
</Window>
