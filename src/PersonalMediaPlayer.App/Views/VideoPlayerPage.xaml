<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Video"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="AddedText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <StackPanel
                x:Name="WatchActions"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button Click="EditVideo_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestoreButton" Click="Restore_Click" Content="Restore original" Visibility="Collapsed" />
                <Button x:Name="EditTrimButton" Click="EditTrim_Click" Content="Trim" IsEnabled="False" />
            </StackPanel>
            <StackPanel
                x:Name="TrimActions"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="TrimSummary"
                    MaxWidth="280"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <ProgressRing x:Name="TrimProgress" Width="20" Height="20" IsActive="False" />
                <Button Click="CancelTrim_Click" Content="Cancel" />
                <Button Click="SaveTrim_Click" Content="Save trim" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Border x:Name="VideoHost" Background="Black" CornerRadius="16">
                <lvs:VideoView x:Name="VideoView" Initialized="VideoView_Initialized" />
            </Border>
            <controls:VideoPlaybackBar
                x:Name="Playback"
                Margin="16"
                VerticalAlignment="Bottom" />
            <Grid
                x:Name="BookmarkHost"
                Margin="16,16,16,88"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="BookmarkToggle"
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Right"
                    Click="BookmarkToggle_Click"
                    ToolTipService.ToolTip="Bookmarks">
                    <FontIcon FontSize="16" Glyph="&#xE700;" />
                </Button>
                <Border
                    x:Name="BookmarkPanel"
                    Grid.Row="1"
                    Width="300"
                    Margin="0,8,0,0"
                    Padding="12"
                    Background="#CC161616"
                    CornerRadius="16"
                    Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BookmarkList" Spacing="8" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="LeavePrompt"
            Grid.RowSpan="2"
            Padding="24"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <TextBlock
                    x:Name="LeavePromptText"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="LeavePromptConfirm"
                    HorizontalAlignment="Stretch"
                    Click="LeavePromptConfirm_Click"
                    Content="Leave"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="LeavePromptStay_Click"
                    Content="Stay" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
