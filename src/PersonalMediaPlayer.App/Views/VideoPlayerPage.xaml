<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="24,8,24,24" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderPanel" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MinWidth="0" RowSpacing="4" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Video"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="AddedText"
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                x:Name="WatchActions"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button x:Name="SaveCopyButton" Click="SaveCopy_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE896;" />
                        <TextBlock x:Name="SaveCopyLabel" Text="Save a copy" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddPlaylistButton" Click="AddPlaylist_Click" ToolTipService.ToolTip="Save this page in a playlist" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock Text="Add to playlist" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="PlaylistButton"
                    Click="PlaylistButton_Click"
                    ToolTipService.ToolTip="Playlist"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE93F;" />
                        <TextBlock Text="Playlist" />
                    </StackPanel>
                </Button>
                <Button x:Name="ChaptersButton" Click="ChaptersButton_Click" ToolTipService.ToolTip="Chapters" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        <TextBlock Text="Chapters" />
                    </StackPanel>
                </Button>
                <Button x:Name="SearchButton" Click="SearchButton_Click" ToolTipService.ToolTip="Search subtitles">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE721;" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
                <Button x:Name="WordsButton" Click="WordsButton_Click" ToolTipService.ToolTip="Saved words">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE82D;" />
                        <TextBlock Text="Words" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Click="EditVideo_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestoreButton" Click="Restore_Click" Content="Restore original" Visibility="Collapsed" />
                <Button x:Name="EditTrimButton" Click="EditTrim_Click" Content="Trim" IsEnabled="False" />
            </StackPanel>
            <StackPanel
                x:Name="TrimActions"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="TrimSummary"
                    MaxWidth="280"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <ProgressRing x:Name="TrimProgress" Width="20" Height="20" IsActive="False" />
                <Button Click="CancelTrim_Click" Content="Cancel" />
                <Button Click="SaveTrim_Click" Content="Save trim" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
            <Border x:Name="VideoHost" Background="Black" CornerRadius="16">
                <lvs:VideoView x:Name="VideoView" Initialized="VideoView_Initialized" />
            </Border>
            <controls:HoverCaptions x:Name="Captions" />
            <controls:VideoPlaybackBar
                x:Name="Playback"
                Margin="16"
                VerticalAlignment="Bottom" />
            <Grid
                x:Name="BookmarkHost"
                Margin="16,16,16,88"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="BookmarkToggle"
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Right"
                    Click="BookmarkToggle_Click"
                    ToolTipService.ToolTip="Bookmarks">
                    <FontIcon FontSize="16" Glyph="&#xE700;" />
                </Button>
                <Border
                    x:Name="BookmarkPanel"
                    Grid.Row="1"
                    Width="300"
                    Margin="0,8,0,0"
                    Padding="12"
                    Background="#CC161616"
                    CornerRadius="16"
                    Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BookmarkList" Spacing="8" />
                    </ScrollViewer>
                </Border>
            </Grid>
            </Grid>
            <controls:ChapterPanel
                x:Name="ChapterPanel"
                Grid.Column="1"
                Margin="12,0,0,0"
                Visibility="Collapsed" />
            <controls:QueuePanel
                x:Name="QueuePanel"
                Grid.Column="2"
                Margin="12,0,0,0"
                Visibility="Collapsed" />
            <controls:PlaylistPanel
                x:Name="PlaylistPanel"
                Grid.Column="3"
                Margin="12,0,0,0"
                Visibility="Collapsed" />
            <controls:SavedWordsPanel
                x:Name="WordsPanel"
                Grid.Column="4"
                Margin="12,0,0,0"
                Visibility="Collapsed" />
            <controls:SubtitleSearchPanel
                x:Name="SubtitleSearchPanel"
                Grid.Column="5"
                Margin="12,0,0,0"
                Visibility="Collapsed" />
        </Grid>

        <Grid
            x:Name="MiniBar"
            Grid.Row="2"
            Padding="10,8,10,10"
            RowSpacing="6"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="MiniTitle"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind TitleText.Text, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="MiniPosition"
                    MinWidth="40"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    FontSize="12"
                    Text="00:00" />
                <Slider
                    x:Name="MiniSeek"
                    Grid.Column="1"
                    Maximum="1000"
                    Minimum="0"
                    IsEnabled="False"
                    AutomationProperties.Name="Position"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="MiniDuration"
                    Grid.Column="2"
                    MinWidth="40"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="12"
                    Text="--:--" />
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="MiniBack"
                    Height="36"
                    MinWidth="52"
                    Padding="8,0"
                    AutomationProperties.Name="Back 10 seconds"
                    Click="RewindButton_Click"
                    ToolTipService.ToolTip="Back 10 seconds">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="12" Glyph="&#xE100;" />
                        <TextBlock FontSize="12" VerticalAlignment="Center" Text="10" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="MiniPlay"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="Play or pause"
                    Click="PlayPauseButton_Click"
                    ToolTipService.ToolTip="Play or pause">
                    <FontIcon x:Name="MiniPlayIcon" FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    x:Name="MiniForward"
                    Height="36"
                    MinWidth="52"
                    Padding="8,0"
                    AutomationProperties.Name="Forward 10 seconds"
                    Click="ForwardButton_Click"
                    ToolTipService.ToolTip="Forward 10 seconds">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="12" VerticalAlignment="Center" Text="10" />
                        <FontIcon FontSize="12" Glyph="&#xE101;" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="MiniNext"
                    Height="36"
                    MinWidth="64"
                    Padding="12,0"
                    AutomationProperties.Name="Next"
                    Click="MiniNext_Click"
                    Content="Next"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Play the next waiting video, then the next playlist video" />
            </StackPanel>
            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    x:Name="MiniVolume"
                    Maximum="100"
                    Minimum="0"
                    AutomationProperties.Name="Volume"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="Full player"
                    Click="MiniExpand_Click"
                    ToolTipService.ToolTip="Full player">
                    <FontIcon FontSize="14" Glyph="&#xE740;" />
                </Button>
                <Button
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="Close"
                    Click="MiniClose_Click"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Grid>

        <Grid
            x:Name="LeavePrompt"
            Grid.RowSpan="3"
            Padding="24"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <TextBlock
                    x:Name="LeavePromptText"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="LeavePromptConfirm"
                    HorizontalAlignment="Stretch"
                    Click="LeavePromptConfirm_Click"
                    Content="Leave"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="LeavePromptStay_Click"
                    Content="Stay" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
