<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PersonalMediaPlayer.App.Views.RecordingBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recording">
    <Border Padding="16,12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid VerticalAlignment="Center" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Ellipse
                    x:Name="LiveDot"
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Fill="#66FFFFFF" />
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        x:Name="TimerText"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="00:00" />
                    <TextBlock
                        x:Name="DetailText"
                        MaxWidth="220"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Recording"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    x:Name="PauseButton"
                    Height="40"
                    MinWidth="112"
                    Padding="12,0"
                    Click="Pause_Click"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="PauseIcon" FontSize="16" Glyph="&#xE769;" />
                        <TextBlock x:Name="PauseLabel" VerticalAlignment="Center" Text="Pause" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="RestartButton"
                    Height="40"
                    MinWidth="116"
                    Padding="12,0"
                    Click="Restart_Click"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock VerticalAlignment="Center" Text="Restart" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="StopButton"
                    Height="40"
                    MinWidth="96"
                    Padding="12,0"
                    Click="Stop_Click"
                    CornerRadius="8"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE71A;" />
                        <TextBlock VerticalAlignment="Center" Text="Stop" />
                    </StackPanel>
                </Button>
                <Button
                    Height="40"
                    MinWidth="104"
                    Padding="12,0"
                    Click="Cancel_Click"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                        <TextBlock VerticalAlignment="Center" Text="Cancel" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
