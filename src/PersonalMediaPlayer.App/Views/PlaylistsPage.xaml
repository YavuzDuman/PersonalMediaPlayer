<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="ThemeInk" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="PrimaryInk" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SecondaryInk" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="HoverInk" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="LineInk" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="AccentInk" Background="{ThemeResource AccentFillColorDefaultBrush}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Playlists" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Search by name, drag to rearrange, or sort. The order is saved." />
        </StackPanel>
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Visibility="Collapsed" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Padding="12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NameBox"
                                PlaceholderText="Playlist name"
                                KeyDown="NameBox_KeyDown" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="Create_Click"
                                Content="Create" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="EmptyLists"
                            Margin="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No playlists yet."
                            TextWrapping="Wrap" />
                        <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="PlaylistRows" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <TextBlock
                    x:Name="EmptyDetail"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Create a playlist, then add videos from your library."
                    TextWrapping="Wrap" />
                <Border
                    x:Name="DetailCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="16,14,16,12" Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="DetailTitle"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="DetailCount"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="PlayButton"
                                    Click="Play_Click"
                                    Content="Play"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button Click="AddVideos_Click" Content="Add videos" />
                                <Button Click="Rename_Click" Content="Rename" />
                                <Button Click="Delete_Click" Content="Delete" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="VideoSearch"
                                    PlaceholderText="Search by name"
                                    TextChanged="VideoSearch_TextChanged" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Sort" />
                                    <Button Click="SortByName_Click" Content="Name" ToolTipService.ToolTip="Sort A to Z" />
                                    <Button Click="SortByDate_Click" Content="Date added" ToolTipService.ToolTip="Newest first" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBlock
                                x:Name="EmptyVideos"
                                Margin="16,0,16,16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Add videos from your library, or add a stream from the player."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="VideoHost"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <ScrollViewer
                                    x:Name="VideoScroller"
                                    AllowDrop="True"
                                    DragOver="VideoScroller_DragOver"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="VideoRows" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
