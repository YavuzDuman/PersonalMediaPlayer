<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" Padding="24,8,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="ThemeInk" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="PrimaryInk" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SecondaryInk" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="HoverInk" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="LineInk" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="AccentInk" Background="{ThemeResource AccentFillColorDefaultBrush}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Playlists" />
            <TextBlock
                MaxWidth="720"
                HorizontalAlignment="Left"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Search by name, drag to rearrange, or sort. Right-click a video to mark it watched. The last change can be undone."
                TextWrapping="Wrap" />
        </StackPanel>
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Visibility="Collapsed" />

        <Grid x:Name="PlaylistBody" Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="280" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ListRow" Height="*" />
                <RowDefinition x:Name="DetailRow" Height="0" />
            </Grid.RowDefinitions>
            <Border
                x:Name="ListCard"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Padding="12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NameBox"
                                PlaceholderText="Playlist name"
                                KeyDown="NameBox_KeyDown" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="Create_Click"
                                Content="Create"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="EmptyLists"
                            Margin="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No playlists yet."
                            TextWrapping="Wrap" />
                        <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="PlaylistRows" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="DetailHost" Grid.Column="1">
                <TextBlock
                    x:Name="EmptyDetail"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Create a playlist, then add videos from your library."
                    TextWrapping="Wrap" />
                <Border
                    x:Name="DetailCard"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="16" Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="DetailTitle"
                                    MaxLines="2"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailCount"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:WrapBar Spacing="8">
                                <Button
                                    x:Name="PlayButton"
                                    Click="Play_Click"
                                    Content="Play"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                                <Button
                                    Click="AddVideos_Click"
                                    Content="Add videos"
                                    Style="{StaticResource ActionButtonStyle}" />
                                <Button
                                    Click="Rename_Click"
                                    Content="Rename"
                                    Style="{StaticResource ActionButtonStyle}" />
                                <Button
                                    Click="Delete_Click"
                                    Content="Delete"
                                    Style="{StaticResource DestructiveButtonStyle}" />
                                <CheckBox
                                    x:Name="UnwatchedBox"
                                    VerticalAlignment="Center"
                                    Checked="Unwatched_Changed"
                                    Content="Unwatched only"
                                    Unchecked="Unwatched_Changed" />
                            </controls:WrapBar>
                            <TextBox
                                x:Name="VideoSearch"
                                PlaceholderText="Search by name"
                                TextChanged="VideoSearch_TextChanged" />
                            <controls:WrapBar Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Sort" />
                                <Button
                                    Click="SortByName_Click"
                                    Content="Name"
                                    Style="{StaticResource ActionButtonStyle}"
                                    ToolTipService.ToolTip="Sort A to Z" />
                                <Button
                                    Click="SortByDate_Click"
                                    Content="Date added"
                                    Style="{StaticResource ActionButtonStyle}"
                                    ToolTipService.ToolTip="Newest first" />
                            </controls:WrapBar>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBlock
                                x:Name="EmptyVideos"
                                Margin="16,0,16,16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Add videos from your library, or add a stream from the player."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="VideoHost"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <ScrollViewer
                                    x:Name="VideoScroller"
                                    AllowDrop="True"
                                    DragOver="VideoScroller_DragOver"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="VideoRows" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
