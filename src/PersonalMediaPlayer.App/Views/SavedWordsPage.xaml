<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.SavedWordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" Padding="24,8,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="ThemeInk" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="PrimaryInk" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SecondaryInk" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="HoverInk" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="LineInk" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </StackPanel>

        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Saved words" />
                <TextBlock
                    MaxWidth="720"
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Click a word to open its video. The list stays open beside the video."
                    TextWrapping="Wrap" />
            </StackPanel>
            <controls:WrapBar Spacing="8">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="220"
                    MaxWidth="420"
                    PlaceholderText="Search words"
                    QueryIcon="Find"
                    TextChanged="Search_TextChanged" />
                <TextBlock
                    x:Name="CountText"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:WrapBar>
            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="1">
            <TextBlock
                x:Name="EmptyText"
                MaxWidth="560"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Border
                x:Name="ListHost"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <ScrollViewer x:Name="WordScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="WordList" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
