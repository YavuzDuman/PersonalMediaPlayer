<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.SavedWordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" Padding="24,8,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="ThemeInk" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="PrimaryInk" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SecondaryInk" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="HoverInk" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="LineInk" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </StackPanel>

        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Saved words" />
                <TextBlock
                    MaxWidth="720"
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Click a word to open its video. Review covers each word and asks you to recall it. The list stays open beside the video."
                    TextWrapping="Wrap" />
            </StackPanel>
            <controls:WrapBar Spacing="8">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="220"
                    MaxWidth="420"
                    PlaceholderText="Search words"
                    QueryIcon="Find"
                    TextChanged="Search_TextChanged" />
                <Button
                    x:Name="ReviewButton"
                    Click="Review_Click"
                    Content="Review"
                    IsEnabled="False"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTipService.ToolTip="Cover each saved word and recall it" />
                <TextBlock
                    x:Name="CountText"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:WrapBar>
            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="1">
            <TextBlock
                x:Name="EmptyText"
                MaxWidth="560"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Border
                x:Name="ReviewHost"
                Padding="28,24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="16">
                    <TextBlock
                        x:Name="ReviewCount"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="ReviewSource"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="ReviewPrompt"
                        FontSize="22"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="ReviewAnswer" Spacing="4" Visibility="Collapsed">
                        <TextBlock
                            x:Name="ReviewWord"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ReviewMeaning"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ReviewSentence"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:WrapBar Spacing="8">
                        <Button
                            x:Name="ReviewShow"
                            Click="ReviewShow_Click"
                            Content="Show the word"
                            Style="{StaticResource ActionButtonStyle}" />
                        <Button
                            x:Name="ReviewNext"
                            Click="ReviewNext_Click"
                            Content="Next"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="ReviewOpen"
                            Click="ReviewOpen_Click"
                            Content="Open video"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            Click="ReviewStop_Click"
                            Content="Back to the list"
                            Style="{StaticResource ActionButtonStyle}" />
                    </controls:WrapBar>
                </StackPanel>
            </Border>
            <Border
                x:Name="ListHost"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <ScrollViewer x:Name="WordScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="WordList" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
