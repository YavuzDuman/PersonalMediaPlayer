<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="HomeAllButton" TargetType="HyperlinkButton">
            <Setter Property="Content" Value="All" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Home" />
            <TextBlock
                x:Name="PageLead"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Continue a video, open a playlist, or go back to something you just added." />
        </StackPanel>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="28">
                <StackPanel x:Name="EmptyState" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Nothing here yet." />
                    <TextBlock
                        x:Name="EmptyLead"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Import a file or open a video link."
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="8">
                        <Button Click="Import_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                        <Button Click="OpenLink_Click" Content="Open link" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ContinueSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel x:Name="ContinueHeading" Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Continue watching" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="ContinueAll" Click="ContinueAll_Click" Style="{StaticResource HomeAllButton}" />
                    </StackPanel>
                    <ScrollViewer
                        x:Name="ContinueRow"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel x:Name="ContinueList" Orientation="Horizontal" Spacing="12" />
                    </ScrollViewer>
                    <Grid x:Name="ContinueGrid" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="PlaylistsSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Playlists" VerticalAlignment="Center" />
                        <HyperlinkButton Click="PlaylistsAll_Click" Style="{StaticResource HomeAllButton}" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Hover a playlist to see its videos." />
                    <StackPanel Spacing="12">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel x:Name="PlaylistList" Orientation="Horizontal" Spacing="12" />
                        </ScrollViewer>
                        <StackPanel x:Name="PlaylistPreview" Spacing="8" Opacity="0" Visibility="Collapsed">
                            <TextBlock x:Name="PlaylistPreviewTitle" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel x:Name="PlaylistPreviewList" Orientation="Horizontal" Spacing="12" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="RecentSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recent" VerticalAlignment="Center" />
                        <HyperlinkButton Click="RecentAll_Click" Style="{StaticResource HomeAllButton}" />
                    </StackPanel>
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel x:Name="RecentList" Orientation="Horizontal" Spacing="12" />
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="WordsSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Saved words" VerticalAlignment="Center" />
                        <HyperlinkButton Click="WordsAll_Click" Style="{StaticResource HomeAllButton}" />
                    </StackPanel>
                    <StackPanel x:Name="WordList" MaxWidth="720" HorizontalAlignment="Left" Spacing="8" />
                </StackPanel>

                <StackPanel x:Name="DownloadsSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Downloads" VerticalAlignment="Center" />
                        <HyperlinkButton Click="DownloadsAll_Click" Style="{StaticResource HomeAllButton}" />
                    </StackPanel>
                    <Border
                        Padding="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Tapped="Downloads_Tapped">
                        <StackPanel x:Name="DownloadList" MaxWidth="720" Spacing="0" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
