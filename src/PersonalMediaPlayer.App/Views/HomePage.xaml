<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="HomeSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="HomeSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HomeDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="HomeThumbStyle" TargetType="Border">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="68" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="HomeSecondaryIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="24,8,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Home" />
            <TextBlock
                x:Name="PageLead"
                MaxWidth="720"
                HorizontalAlignment="Left"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Continue a video, open a playlist, or go back to something you just added."
                TextWrapping="Wrap" />
            <AutoSuggestBox
                x:Name="SearchBox"
                MaxWidth="560"
                Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                PlaceholderText="Search library, playlists, and captions"
                QueryIcon="Find"
                TextChanged="Search_TextChanged" />
        </StackPanel>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True" />

        <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32">
                <StackPanel x:Name="SearchSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock
                        x:Name="SearchEmpty"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Nothing matches."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="SearchCard"
                        MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed">
                        <StackPanel x:Name="SearchList" />
                    </Border>
                    <TextBlock
                        x:Name="CaptionHeading"
                        Style="{StaticResource HomeSectionTitle}"
                        Text="Captions"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="CaptionCard"
                        MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel x:Name="CaptionList" />
                            <TextBlock
                                x:Name="CaptionMore"
                                Margin="12,4,12,12"
                                Style="{StaticResource HomeSecondaryTextStyle}"
                                Text="More caption matches are not listed."
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="EmptyState" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Nothing here yet." />
                    <TextBlock
                        x:Name="EmptyLead"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Import a file or open a video link."
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="8">
                        <Button Click="Import_Click" Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                        <Button Click="OpenLink_Click" Content="Open link" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ContinueSection" Spacing="12" Visibility="Collapsed">
                    <Grid x:Name="ContinueHeading" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Continue watching" />
                        <Button
                            x:Name="ContinueAll"
                            Grid.Column="1"
                            Click="ContinueAll_Click"
                            Content="All"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <ScrollViewer
                        x:Name="ContinueRow"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel x:Name="ContinueList" Orientation="Horizontal" Spacing="12" />
                    </ScrollViewer>
                    <Grid x:Name="ContinueGrid" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="PlaylistsSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Playlists" />
                        <Button
                            Grid.Column="1"
                            Click="PlaylistsAll_Click"
                            Content="All"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Hover a playlist to see its videos."
                        TextWrapping="Wrap" />
                    <StackPanel Spacing="12">
                        <ScrollViewer
                            x:Name="PlaylistRow"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel x:Name="PlaylistList" Orientation="Horizontal" Spacing="12" />
                        </ScrollViewer>
                        <StackPanel x:Name="PlaylistPreview" Spacing="8" Opacity="0" Visibility="Collapsed">
                            <TextBlock
                            x:Name="PlaylistPreviewTitle"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                            <ScrollViewer
                                x:Name="PlaylistPreviewRow"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel x:Name="PlaylistPreviewList" Orientation="Horizontal" Spacing="12" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="RecentSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Recent" />
                        <Button
                            Grid.Column="1"
                            Click="RecentAll_Click"
                            Content="All"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <ScrollViewer
                        x:Name="RecentRow"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel x:Name="RecentList" Orientation="Horizontal" Spacing="12" />
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="WordsSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Saved words" />
                        <Button
                            Grid.Column="1"
                            Click="WordsAll_Click"
                            Content="All"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <Border
                        MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel x:Name="WordList" />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DownloadsSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Downloads" />
                        <Button
                            Grid.Column="1"
                            Click="DownloadsAll_Click"
                            Content="All"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <Border
                        MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Tapped="Downloads_Tapped">
                        <StackPanel x:Name="DownloadList" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
