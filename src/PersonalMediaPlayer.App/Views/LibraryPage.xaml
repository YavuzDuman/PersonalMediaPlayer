<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    xmlns:converters="using:PersonalMediaPlayer.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PersonalMediaPlayer.Core.Models"
    xmlns:viewmodels="using:PersonalMediaPlayer.App.ViewModels"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    PreviewKeyDown="Page_PreviewKeyDown"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:BoolToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
        <Style x:Key="LibrarySectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="24,8,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Library" />
                    <TextBlock
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Select, organize, drop files, and inspect details"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button Command="{x:Bind ViewModel.ImportCommand}" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                            <TextBlock Text="Import" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <controls:WrapBar Spacing="8">
                <AutoSuggestBox
                    x:Name="LibrarySearch"
                    MaxWidth="420"
                    MinWidth="200"
                    PlaceholderText="Search by name, type, folder, or screenshot text"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="SearchBox_TextChanged" />
                <ComboBox
                    MinWidth="140"
                    Header="Filter"
                    ItemsSource="{x:Bind ViewModel.TypeFilters}"
                    SelectedIndex="{x:Bind ViewModel.TypeFilterIndex, Mode=TwoWay}" />
                <ComboBox
                    MinWidth="160"
                    Header="Sort"
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />
            </controls:WrapBar>
            <controls:WrapBar Spacing="8">
                <Button Click="OpenLink_Click" Content="Open link" Style="{StaticResource ActionButtonStyle}" />
                <Button Click="NewFolder_Click" Content="New folder" Style="{StaticResource ActionButtonStyle}" />
                <Button Click="AddTo_Click" Content="Add to" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource ActionButtonStyle}" />
                <Button Click="MoveTo_Click" Content="Move to" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource ActionButtonStyle}" />
                <Button Click="Delete_Click" Content="Delete" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource DestructiveButtonStyle}" />
                <Button Click="Open_Click" Content="Open" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource ActionButtonStyle}" />
                <Button Click="Slideshow_Click" Content="Slideshow" Style="{StaticResource ActionButtonStyle}" />
            </controls:WrapBar>
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=TwoWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

        <Grid x:Name="LibraryBody" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderColumn" Width="260" />
                <ColumnDefinition x:Name="MediaColumn" Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MainRow" Height="*" />
                <RowDefinition x:Name="DetailRow" Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="FolderPane"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                AllowDrop="True"
                DragOver="FolderList_DragOver"
                Drop="FolderList_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource LibrarySectionTitle}" Text="Folders" />
                    <ListView
                        x:Name="FolderList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                        RightTapped="FolderList_RightTapped"
                        SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryFolder">
                                <controls:FolderRow Folder="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="On this PC" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="New photos and videos in a connected folder show up while the app is open. Refresh looks again."
                            TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ConnectedPcFolders, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ConnectedPcFolder">
                                        <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Label}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Path}" />
                                            <Button
                                                Grid.Column="1"
                                                Click="DisconnectFolder_Click"
                                                Content="Disconnect"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Tag="{x:Bind Path}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ConnectPcFolderCommand}"
                            Content="Connect folder"
                            Style="{StaticResource ActionButtonStyle}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.RefreshPcFoldersCommand}"
                            Content="Refresh"
                            Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MediaPane" Grid.Column="1">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <FontIcon FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Glyph="&#xEB9F;" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No media in this view" />
                    <TextBlock
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <GridView
                    x:Name="MediaGrid"
                    CanDragItems="True"
                    DragItemsStarting="MediaGrid_DragItemsStarting"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    ContainerContentChanging="MediaGrid_ContainerContentChanging"
                    SelectionChanged="MediaGrid_SelectionChanged"
                    SelectionMode="Extended"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource VisibleWhenFalse}}"
                    DoubleTapped="MediaGrid_DoubleTapped"
                    RightTapped="MediaGrid_RightTapped">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <controls:MediaCard Item="{x:Bind}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="viewmodels:DuplicateGroup">
                                    <TextBlock
                                        Margin="0,8,0,8"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind Label}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </GridView.GroupStyle>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <Border
                    x:Name="SelectionBar"
                    Padding="12,10"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <controls:WrapBar Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectionCountLabel, Mode=OneWay}" />
                        <Button
                            Click="PlayNext_Click"
                            Content="Play next"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanOrganizeSelection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <Button
                            Click="AddToQueue_Click"
                            Content="Add to queue"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanOrganizeSelection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <Button
                            Click="AddToPlaylist_Click"
                            Content="Add to playlist"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanOrganizeSelection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <Button
                            Click="AddFavorites_Click"
                            Content="Add to favorites"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanOrganizeSelection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <Button
                            Click="RemoveFavorites_Click"
                            Content="Remove from favorites"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanOrganizeSelection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <Button
                            Click="LocateFolder_Click"
                            Content="Locate in folder"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanLocateFolder, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <Button Click="ClearSelection_Click" Content="Clear" Style="{StaticResource ActionButtonStyle}" />
                    </controls:WrapBar>
                </Border>
            </Grid>

            <Border
                x:Name="DetailsPane"
                Grid.Column="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource LibrarySectionTitle}" Text="Details" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select an item to see its details. Ctrl+click, Shift+click, or Ctrl+A selects the files in this view. Drop files to add them. Drag onto a folder to add an item. Move to takes it out of the folder you are viewing. Photos, Videos, and This month fill themselves."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource VisibleWhenFalse}}" />
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.DetailsItem.DisplayName, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.DetailsItem.TypeLabel, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.DetailsItem.SizeLabel, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.DetailsFolder, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.DetailsImported, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.DetailsPlace, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.DetailsExtra, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DetailsItem.FilePath, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Left"
                                Click="Locate_Click"
                                Content="Locate"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="{x:Bind ViewModel.CanLocate, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SelectionLabel, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid
            x:Name="Slideshow"
            Grid.RowSpan="4"
            Background="Black"
            IsTabStop="True"
            KeyDown="Slideshow_KeyDown"
            Visibility="Collapsed">
            <Image x:Name="SlideshowImage" Stretch="Uniform" />
            <Border
                Margin="24"
                Padding="16,10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="#CC161616"
                CornerRadius="16">
                <Grid>
                    <TextBlock
                        x:Name="SlideshowCaption"
                        VerticalAlignment="Center"
                        Foreground="White" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button Click="SlideshowPrev_Click" Content="Previous" />
                        <Button Click="SlideshowNext_Click" Content="Next" />
                        <Button Click="SlideshowClose_Click" Content="Close" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
