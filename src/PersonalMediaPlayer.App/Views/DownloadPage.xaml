<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    xmlns:download="using:PersonalMediaPlayer.App.Download"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageGrid" Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Download" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="Add YouTube, Shorts, or music links. Choose a quality for each one. They download in order, then you preview and save each file." />
        </StackPanel>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid x:Name="WorkGrid" Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="EntryPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <TextBox
                        x:Name="LinkBox"
                        Header="YouTube link"
                        PlaceholderText="https://www.youtube.com/watch?v=…"
                        KeyDown="LinkBox_KeyDown"
                        TextChanged="LinkBox_TextChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="LookupButton"
                            Click="Lookup_Click"
                            Content="Look up"
                            Style="{StaticResource AccentButtonStyle}" />
                        <ProgressRing x:Name="LookupRing" IsActive="False" />
                    </StackPanel>

                    <StackPanel x:Name="QualityPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose a quality before the download starts." />
                        <ListView
                            x:Name="QualityList"
                            MaxHeight="320"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="download:DownloadQuality">
                                    <TextBlock Padding="4" Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button
                            x:Name="DownloadButton"
                            HorizontalAlignment="Left"
                            Click="Download_Click"
                            Content="Add to queue"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:Name="DownloadStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Queue" />
                        <TextBlock
                            x:Name="EmptyQueue"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nothing is queued."
                            TextWrapping="Wrap" />
                        <ListView x:Name="QueueList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="download:DownloadQueueItem">
                                    <Grid Padding="0,8" ColumnSpacing="8" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Detail, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <ProgressBar
                                            Grid.Row="2"
                                            Maximum="100"
                                            Value="{x:Bind Progress, Mode=OneWay}"
                                            Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Click="PreviewItem_Click" Content="Preview" Visibility="{x:Bind PreviewVisibility, Mode=OneWay}" />
                                            <Button Click="RetryItem_Click" Content="Retry" Visibility="{x:Bind RetryVisibility, Mode=OneWay}" />
                                            <Button Click="PauseItem_Click" Content="Pause" Visibility="{x:Bind PauseVisibility, Mode=OneWay}" />
                                            <Button Click="ResumeItem_Click" Content="Resume" Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" />
                                            <Button Click="CancelItem_Click" Content="Cancel" Visibility="{x:Bind CancelVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="PreviewPanel" Grid.Column="1" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="PreviewTitleRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PreviewTitle"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Click="Save_Click" Content="Save" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="Discard_Click" Content="Discard" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Border Background="Black" CornerRadius="16">
                        <Grid>
                            <Border x:Name="VideoHost" />
                            <StackPanel
                                x:Name="AudioMark"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                                <FontIcon FontSize="48" Foreground="White" Glyph="&#xE8D6;" />
                                <TextBlock Foreground="White" Text="Audio" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <controls:VideoPlaybackBar
                        x:Name="Playback"
                        Margin="16"
                        VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Grid>

        <Border
            x:Name="HistoryPanel"
            Grid.Row="3"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="History" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Removing an entry does not delete the file." />
                </Grid>
                <TextBlock
                    x:Name="EmptyHistory"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Saved downloads will appear here." />
                <ListView
                    x:Name="HistoryList"
                    MaxHeight="340"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="download:DownloadHistoryEntry">
                            <Border
                                Width="320"
                                Padding="14"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Height="156" Background="Black" CornerRadius="8">
                                        <Grid>
                                            <Image
                                                Stretch="UniformToFill"
                                                Source="{x:Bind ThumbnailUrl}"
                                                Visibility="{x:Bind ThumbnailVisibility}" />
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="32"
                                                Foreground="White"
                                                Glyph="&#xE8D6;"
                                                Visibility="{x:Bind PlaceholderVisibility}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Detail}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Url}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Url}" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Folder}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Location}" />
                                    <StackPanel Grid.Row="5" Margin="0,6,0,0" Orientation="Horizontal" Spacing="8">
                                        <Button Click="OpenHistoryFile_Click" Content="Open" />
                                        <Button Click="OpenHistoryFolder_Click" Content="Folder" />
                                        <Button Click="RemoveHistory_Click" Content="Remove" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <Grid
            x:Name="LeavePrompt"
            Grid.RowSpan="4"
            Padding="24"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <TextBlock
                    x:Name="LeavePromptText"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="LeavePromptConfirm_Click"
                    Content="Leave"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="LeavePromptStay_Click"
                    Content="Stay" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
