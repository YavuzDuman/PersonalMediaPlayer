<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalMediaPlayer.App.Views.VideoEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" Padding="24,8,24,24" ColumnSpacing="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Edit video" />
                <TextBlock
                    x:Name="FileNameText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="SaveProgress" Width="20" Height="20" IsActive="False" />
                <Button Click="Cancel_Click" Content="Cancel" />
                <Button
                    x:Name="SaveButton"
                    Click="Save_Click"
                    Content="Save"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid Grid.Row="2">
            <Border x:Name="VideoHost" Background="Black" CornerRadius="16" />
            <Border
                Margin="16"
                Padding="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#CC161616"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="TimelineHint"
                        Foreground="White"
                        Text="Click the line to move the playhead."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ModeSeekButton" Click="TimelineMode_Click" Content="Playhead" Tag="seek" />
                        <Button x:Name="ModeTrimButton" Click="TimelineMode_Click" Content="Trim ends" Tag="trim" />
                        <Button x:Name="ModeCutButton" Click="TimelineMode_Click" Content="Remove part" Tag="cut" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <controls:VideoPlaybackBar x:Name="Playback" Margin="16" VerticalAlignment="Bottom" />
        </Grid>

        <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Adjustments" />
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Speed" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="1× is the original. The pitch rises and falls with the speed."
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="SpeedLabel" Style="{StaticResource SubtitleTextBlockStyle}" Text="1×" />
                        <TextBlock
                            x:Name="DurationLabel"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Length stays the same until a speed is chosen."
                            TextWrapping="Wrap" />
                        <Slider
                            x:Name="SpeedSlider"
                            Maximum="4"
                            Minimum="0.25"
                            StepFrequency="0.05"
                            Value="1"
                            ValueChanged="SpeedSlider_ValueChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="Preset_Click" Content="0.5x" Tag="0.5" />
                            <Button Click="Preset_Click" Content="1x" Tag="1" />
                            <Button Click="Preset_Click" Content="1.5x" Tag="1.5" />
                            <Button Click="Preset_Click" Content="2x" Tag="2" />
                            <Button Click="Preset_Click" Content="4x" Tag="4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Volume" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="100% is the original loudness. 0% saves silence."
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="VolumeLabel" Style="{StaticResource SubtitleTextBlockStyle}" Text="100%" />
                        <Slider
                            x:Name="VolumeSlider"
                            Maximum="100"
                            Minimum="0"
                            StepFrequency="1"
                            Value="100"
                            ValueChanged="VolumeSlider_ValueChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="VolumePreset_Click" Content="Mute" Tag="0" />
                            <Button Click="VolumePreset_Click" Content="50%" Tag="50" />
                            <Button Click="VolumePreset_Click" Content="100%" Tag="100" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Trim" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose Trim ends, then drag a white handle. These buttons move that handle by a fixed amount."
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="TrimSummary" Text="The whole video is kept." TextWrapping="Wrap" />
                        <TextBlock x:Name="TrimStartLabel" Text="Start 0:00" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Click="NudgeTrim_Click" Content="−1s" Tag="start:-1000" />
                            <Button Click="NudgeTrim_Click" Content="−0.1s" Tag="start:-100" />
                            <Button Click="NudgeTrim_Click" Content="+0.1s" Tag="start:100" />
                            <Button Click="NudgeTrim_Click" Content="+1s" Tag="start:1000" />
                        </StackPanel>
                        <Button Click="TrimStart_Click" HorizontalAlignment="Left" Content="Set start to playhead" />
                        <TextBlock x:Name="TrimEndLabel" Text="End 0:00" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Click="NudgeTrim_Click" Content="−1s" Tag="end:-1000" />
                            <Button Click="NudgeTrim_Click" Content="−0.1s" Tag="end:-100" />
                            <Button Click="NudgeTrim_Click" Content="+0.1s" Tag="end:100" />
                            <Button Click="NudgeTrim_Click" Content="+1s" Tag="end:1000" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="TrimEnd_Click" Content="Set end to playhead" />
                            <Button Click="ResetTrim_Click" Content="Full video" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Remove section" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose Remove part, then drag across the piece to delete. A short click only moves the playhead."
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="CutMarkLabel" Text="Nothing selected yet." TextWrapping="Wrap" />
                        <TextBlock Text="From" />
                        <TextBox
                            x:Name="CutFromBox"
                            PlaceholderText="0:00.0"
                            LostFocus="CutTime_LostFocus"
                            KeyDown="CutTime_KeyDown" />
                        <TextBlock Text="To" />
                        <TextBox
                            x:Name="CutToBox"
                            PlaceholderText="0:12.5"
                            LostFocus="CutTime_LostFocus"
                            KeyDown="CutTime_KeyDown" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Type minutes:seconds, such as 1:05.4. The yellow band on the timeline is this span."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="SelectCutButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="SelectCut_Click"
                            Content="Drag on the timeline" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="MarkStart_Click"
                            Content="Start at playhead" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="MarkEnd_Click"
                            Content="End at playhead" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="RemoveCut_Click"
                            Content="Remove this part"
                            Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel x:Name="CutList" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="LeavePrompt"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Padding="24"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed">
            <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock
                    Text="These edits are not saved. Leave without keeping them?"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="LeavePromptConfirm_Click"
                    Content="Leave"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button HorizontalAlignment="Stretch" Click="LeavePromptStay_Click" Content="Stay" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
