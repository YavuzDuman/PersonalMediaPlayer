<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.ContinueWatchCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="220">
    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Tapped="Card_Tapped">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="124" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12,12,0,0" />
                <Image x:Name="Thumb" Stretch="UniformToFill" ImageFailed="Thumb_Failed" />
                <ProgressBar
                    x:Name="Progress"
                    Height="4"
                    Margin="0,0,0,0"
                    VerticalAlignment="Bottom"
                    Maximum="100"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <Border
                    x:Name="PlayShade"
                    Width="44"
                    Height="44"
                    Margin="0,0,4,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#99000000"
                    CornerRadius="22"
                    IsHitTestVisible="False" />
                <Button
                    x:Name="PlayButton"
                    Margin="0,0,8,14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="Play_Click"
                    Style="{StaticResource IconAccentButtonStyle}"
                    ToolTipService.ToolTip="Play">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE768;"
                        IsHitTestVisible="False" />
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="2">
                <TextBlock
                    x:Name="Title"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="Place"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
