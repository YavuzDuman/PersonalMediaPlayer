<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.ContinueWatchCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="220">
    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Tapped="Card_Tapped">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="124" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12,12,0,0" />
                <Image x:Name="Thumb" Stretch="UniformToFill" ImageFailed="Thumb_Failed" />
                <Border x:Name="PlayShade" Background="#66000000" CornerRadius="12,12,0,0" IsHitTestVisible="False" />
                <FontIcon
                    x:Name="PlayMark"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="28"
                    Foreground="White"
                    Glyph="&#xE768;" />
                <ProgressBar
                    x:Name="Progress"
                    Height="4"
                    Margin="0,0,0,0"
                    VerticalAlignment="Bottom"
                    Maximum="100"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            </Grid>
            <StackPanel Grid.Row="1" Padding="12,8,12,10" Spacing="2">
                <TextBlock
                    x:Name="Title"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="Place"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
