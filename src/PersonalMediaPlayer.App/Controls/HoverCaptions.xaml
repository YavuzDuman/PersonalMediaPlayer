<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.HoverCaptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Margin="24,0,24,176">
    <Grid>
        <StackPanel x:Name="Line" Orientation="Horizontal" />
        <Canvas IsHitTestVisible="False">
            <Border
                x:Name="MeaningCard"
                Padding="8,4"
                Background="#F21B1B1B"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="MeaningText"
                    MaxWidth="320"
                    Foreground="White"
                    FontSize="13"
                    TextWrapping="Wrap" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
