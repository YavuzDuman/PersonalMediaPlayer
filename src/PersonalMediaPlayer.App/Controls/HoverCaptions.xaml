<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.HoverCaptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <Grid>
        <Border
            x:Name="Dismiss"
            Background="Transparent"
            PointerPressed="Dismiss_Pressed"
            Visibility="Collapsed" />
        <Border
            x:Name="CaptionPlate"
            Margin="24,0,24,176"
            Padding="12,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#CC000000"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel x:Name="Line" Orientation="Horizontal" VerticalAlignment="Center" />
                <Button
                    x:Name="SaveLineButton"
                    Height="32"
                    MinWidth="72"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Click="SaveLine_Click"
                    Content="Save"
                    CornerRadius="8"
                    FontSize="13"
                    RequestedTheme="Dark"
                    ToolTipService.ToolTip="Save this line on this computer"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Canvas x:Name="MeaningLayer" IsHitTestVisible="False">
            <Border
                x:Name="MeaningCard"
                Padding="8,4"
                Background="#F21B1B1B"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="MeaningText"
                    MaxWidth="320"
                    Foreground="White"
                    FontSize="13"
                    TextWrapping="Wrap" />
            </Border>
        </Canvas>
        <Border
            x:Name="WordCard"
            MaxWidth="440"
            Margin="24,32,24,0"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#F2161616"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#B3FFFFFF"
                        FontSize="12"
                        Text="Word" />
                    <Button
                        HorizontalAlignment="Right"
                        Padding="10,4"
                        Click="CloseCard_Click"
                        Content="Close"
                        ToolTipService.ToolTip="Close this card" />
                </Grid>
                <TextBlock
                    x:Name="CardWord"
                    MaxHeight="76"
                    Foreground="White"
                    FontSize="28"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Foreground="#B3FFFFFF" FontSize="12" Text="Turkish" />
                        <TextBlock
                            x:Name="CardMeaning"
                            Foreground="White"
                            FontSize="18"
                            TextWrapping="Wrap" />
                        <TextBlock Foreground="#B3FFFFFF" FontSize="12" Text="Sentence" />
                        <TextBlock
                            x:Name="CardSentence"
                            Foreground="#E6FFFFFF"
                            FontSize="14"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <Button
                    x:Name="SaveWordButton"
                    HorizontalAlignment="Left"
                    Click="SaveWord_Click"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Save this word on this computer" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
