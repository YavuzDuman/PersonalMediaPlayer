<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.VideoPlaybackBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border
        Padding="16,12"
        Background="#CC161616"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        CornerRadius="16">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PositionText"
                    x:FieldModifier="public"
                    MinWidth="48"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="00:00" />
                <ScrollViewer
                    x:Name="TimelineScroll"
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    SizeChanged="TimelineScroll_SizeChanged"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <Grid x:Name="TimelineHost" MinHeight="28" Background="Transparent">
                        <Canvas x:Name="CutsCanvas" IsHitTestVisible="False" />
                        <Slider
                            x:Name="SeekSlider"
                            x:FieldModifier="public"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            IsThumbToolTipEnabled="False"
                            Maximum="1000"
                            Minimum="0"
                            StepFrequency="1" />
                        <Canvas x:Name="RepeatCanvas" Height="28" IsHitTestVisible="False" Visibility="Collapsed">
                            <Border
                                x:Name="RepeatSpan"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="#CC7DD3FC"
                                CornerRadius="2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Grid x:Name="RepeatMarkA" Width="18" Height="22" Visibility="Collapsed">
                                <Border Background="#FF1B6CA8" CornerRadius="4" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="A" />
                            </Grid>
                            <Grid x:Name="RepeatMarkB" Width="18" Height="22" Visibility="Collapsed">
                                <Border Background="#FF0E7C66" CornerRadius="4" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="B" />
                            </Grid>
                        </Canvas>
                        <Canvas
                            x:Name="TrimCanvas"
                            Height="28"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            PointerCanceled="Trim_Released"
                            PointerMoved="Trim_Moved"
                            PointerPressed="Trim_Pressed"
                            PointerReleased="Trim_Released"
                            SizeChanged="TrimCanvas_SizeChanged">
                            <Border
                                x:Name="TrimRange"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="#E6FFFFFF"
                                CornerRadius="2"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="TrimStartThumb"
                                Width="12"
                                Height="22"
                                Background="White"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="TrimEndThumb"
                                Width="12"
                                Height="22"
                                Background="White"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
                <TextBlock
                    x:Name="DurationText"
                    x:FieldModifier="public"
                    Grid.Column="2"
                    MinWidth="48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="--:--" />
            </Grid>
            <StackPanel
                x:Name="ZoomBar"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <Button
                    x:Name="ZoomOutButton"
                    MinWidth="32"
                    Padding="8,2"
                    Click="ZoomOut_Click"
                    Content="−"
                    ToolTipService.ToolTip="Zoom out" />
                <TextBlock
                    x:Name="ZoomLabel"
                    MinWidth="36"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="1×"
                    TextAlignment="Center" />
                <Button
                    x:Name="ZoomInButton"
                    MinWidth="32"
                    Padding="8,2"
                    Click="ZoomIn_Click"
                    Content="+"
                    ToolTipService.ToolTip="Zoom in" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        x:Name="MuteButton"
                        x:FieldModifier="public"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Mute">
                        <FontIcon
                            x:Name="MuteIcon"
                            x:FieldModifier="public"
                            FontSize="16"
                            Glyph="&#xE767;" />
                    </Button>
                    <Slider
                        x:Name="VolumeSlider"
                        x:FieldModifier="public"
                        Width="120"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        Value="80" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="BackButton"
                        x:FieldModifier="public"
                        Height="40"
                        MinWidth="76"
                        Padding="12,0"
                        ToolTipService.ToolTip="Back 10 seconds">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE100;" />
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="10" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PlayButton"
                        x:FieldModifier="public"
                        Width="44"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Play or pause">
                        <FontIcon
                            x:Name="PlayIcon"
                            x:FieldModifier="public"
                            FontSize="16"
                            Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        x:FieldModifier="public"
                        Height="40"
                        MinWidth="76"
                        Padding="12,0"
                        ToolTipService.ToolTip="Forward 10 seconds">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="10" />
                            <FontIcon FontSize="14" Glyph="&#xE101;" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="BookmarkButton"
                        x:FieldModifier="public"
                        Height="40"
                        Padding="12,0"
                        ToolTipService.ToolTip="Bookmark this moment"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8A4;" />
                            <TextBlock VerticalAlignment="Center" Text="Mark" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SnapshotButton"
                        x:FieldModifier="public"
                        Width="44"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Save this frame"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE722;" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Width="44"
                        Height="40"
                        Padding="0"
                        Click="Settings_Click"
                        ToolTipService.ToolTip="Playback settings">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                    <Button
                        x:Name="FullScreenButton"
                        x:FieldModifier="public"
                        Width="44"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Full screen">
                        <FontIcon
                            x:Name="FullScreenIcon"
                            x:FieldModifier="public"
                            FontSize="16"
                            Glyph="&#xE740;" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
        <Border
            x:Name="HoverCard"
            Width="168"
            Padding="4"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#F0161616"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel>
                <Border Height="90" Background="Black" CornerRadius="6">
                    <Image x:Name="HoverImage" Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    x:Name="HoverTime"
                    Margin="0,4,0,2"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    FontSize="12"
                    Text="0:00" />
            </StackPanel>
        </Border>
        <Popup
            x:Name="SettingsPopup"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsLightDismissEnabled="True"
            ShouldConstrainToRootBounds="True">
            <Border
                x:Name="SettingsCard"
                Width="360"
                Padding="16"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Playback" />
                    <StackPanel x:Name="QualityRow" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Quality" />
                        <ComboBox
                            x:Name="QualityCombo"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Quality"
                            SelectionChanged="QualityCombo_Changed"
                            ToolTipService.ToolTip="Video quality" />
                    </StackPanel>
                    <StackPanel x:Name="AudioRow" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Audio" />
                        <ComboBox
                            x:Name="AudioCombo"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Audio"
                            SelectionChanged="AudioCombo_Changed"
                            ToolTipService.ToolTip="Audio language" />
                    </StackPanel>
                    <StackPanel x:Name="CaptionRow" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Captions" />
                        <ComboBox
                            x:Name="CaptionCombo"
                            HorizontalAlignment="Stretch"
                            MaxDropDownHeight="320"
                            PlaceholderText="Captions"
                            SelectionChanged="CaptionCombo_Changed"
                            ToolTipService.ToolTip="Captions"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="SubtitleButton"
                            Height="36"
                            Padding="12,0"
                            HorizontalAlignment="Left"
                            Click="Subtitle_Click"
                            ToolTipService.ToolTip="Show subtitles"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="SubtitleIcon" FontSize="14" Glyph="&#xE7F0;" />
                                <TextBlock x:Name="SubtitleText" VerticalAlignment="Center" Text="CC" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="SpeedRow" Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Speed" />
                        <ComboBox
                            x:Name="SpeedCombo"
                            x:FieldModifier="public"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="3"
                            ToolTipService.ToolTip="Playback speed">
                            <ComboBoxItem Content="0.25×" Tag="0.25" />
                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                            <ComboBoxItem Content="0.75×" Tag="0.75" />
                            <ComboBoxItem Content="1×" Tag="1" />
                            <ComboBoxItem Content="1.25×" Tag="1.25" />
                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                            <ComboBoxItem Content="1.75×" Tag="1.75" />
                            <ComboBoxItem Content="2×" Tag="2" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="RepeatButtons" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            x:Name="RepeatHint"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Repeat a section"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RepeatAButton"
                                Height="36"
                                Padding="12,0"
                                Click="RepeatA_Click"
                                ToolTipService.ToolTip="Mark where the repeat starts">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="A" />
                                    <TextBlock VerticalAlignment="Center" Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="RepeatBButton"
                                Height="36"
                                Padding="12,0"
                                Click="RepeatB_Click"
                                ToolTipService.ToolTip="Mark where the repeat ends">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="B" />
                                    <TextBlock VerticalAlignment="Center" Text="End" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="RepeatClearButton"
                                Height="36"
                                Padding="12,0"
                                Click="RepeatClear_Click"
                                Content="Clear"
                                ToolTipService.ToolTip="Clear the repeat points"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
