<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.VideoPlaybackBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border
        Padding="16,12"
        Background="#CC161616"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        CornerRadius="16">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid>
                        <Border
                            x:Name="PositionHit"
                            Height="28"
                            MinWidth="48"
                            Background="Transparent"
                            AutomationProperties.Name="Current time"
                            Tapped="Position_Tapped">
                            <TextBlock
                                x:Name="PositionText"
                                x:FieldModifier="public"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="00:00" />
                        </Border>
                        <TextBox
                            x:Name="PositionBox"
                            Height="28"
                            MinWidth="76"
                            MaxLength="11"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Visibility="Collapsed"
                            RequestedTheme="Dark"
                            AutomationProperties.Name="Time"
                            KeyDown="PositionBox_KeyDown"
                            LostFocus="PositionBox_LostFocus" />
                    </Grid>
                    <TextBlock
                        x:Name="TimeMessage"
                        MaxWidth="140"
                        Foreground="#FFFFB4AB"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="CaptionLaneLabel"
                        Height="18"
                        Margin="0,4,0,0"
                        VerticalAlignment="Center"
                        Foreground="#CCFFFFFF"
                        FontSize="12"
                        Text="Captions"
                        ToolTipService.ToolTip="Click a line to move the playhead there"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="AudioLaneLabel"
                        Height="22"
                        Margin="0,6,0,0"
                        VerticalAlignment="Center"
                        Foreground="#CCFFFFFF"
                        FontSize="12"
                        Text="Audio"
                        Visibility="Collapsed" />
                </StackPanel>
                <ScrollViewer
                    x:Name="TimelineScroll"
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    SizeChanged="TimelineScroll_SizeChanged"
                    ViewChanged="TimelineScroll_ViewChanged"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <ScrollViewer.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Invoked="TimelinePan_Invoked" />
                        <KeyboardAccelerator Key="Right" Invoked="TimelinePan_Invoked" />
                    </ScrollViewer.KeyboardAccelerators>
                    <Grid x:Name="TimelineHost" MinHeight="28" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Canvas x:Name="CutsCanvas" IsHitTestVisible="False" />
                        <Slider
                            x:Name="SeekSlider"
                            x:FieldModifier="public"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            IsThumbToolTipEnabled="False"
                            Maximum="1000"
                            Minimum="0"
                            StepFrequency="1" />
                        <Canvas x:Name="RepeatCanvas" Height="28" IsHitTestVisible="False" Visibility="Collapsed">
                            <Border
                                x:Name="RepeatSpan"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="#CC7DD3FC"
                                CornerRadius="2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Grid x:Name="RepeatMarkA" Width="18" Height="22" Visibility="Collapsed">
                                <Border Background="#FF1B6CA8" CornerRadius="4" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="A" />
                            </Grid>
                            <Grid x:Name="RepeatMarkB" Width="18" Height="22" Visibility="Collapsed">
                                <Border Background="#FF0E7C66" CornerRadius="4" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="B" />
                            </Grid>
                        </Canvas>
                        <Canvas
                            x:Name="TrimCanvas"
                            Height="28"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            PointerCanceled="Trim_Released"
                            PointerCaptureLost="Trim_Released"
                            PointerMoved="Trim_Moved"
                            PointerPressed="Trim_Pressed"
                            PointerReleased="Trim_Released"
                            SizeChanged="TrimCanvas_SizeChanged">
                            <Border
                                x:Name="TrimRange"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="#E6FFFFFF"
                                CornerRadius="2"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="TrimStartThumb"
                                Width="12"
                                Height="22"
                                Background="White"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="TrimEndThumb"
                                Width="12"
                                Height="22"
                                Background="White"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                        </Canvas>
                        <Border
                            x:Name="CaptionLane"
                            Grid.Row="1"
                            Height="18"
                            Margin="0,4,0,0"
                            Background="#FF242424"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed"
                            PointerExited="Caption_Exited"
                            PointerMoved="Caption_Moved"
                            PointerPressed="Caption_Pressed">
                            <Canvas x:Name="CaptionCanvas" IsHitTestVisible="False" />
                        </Border>
                        <Border
                            x:Name="AudioLane"
                            Grid.Row="2"
                            Height="32"
                            Margin="0,6,0,0"
                            Background="#FF242424"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed"
                            PointerCanceled="Audio_Released"
                            PointerCaptureLost="Audio_Released"
                            PointerMoved="Audio_Moved"
                            PointerPressed="Audio_Pressed"
                            PointerReleased="Audio_Released">
                            <Canvas x:Name="AudioCanvas" IsHitTestVisible="False" />
                        </Border>
                    </Grid>
                </ScrollViewer>
                <TextBlock
                    x:Name="DurationText"
                    x:FieldModifier="public"
                    Grid.Column="2"
                    MinWidth="48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="--:--" />
            </Grid>
            <StackPanel
                x:Name="ZoomBar"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <Button
                    x:Name="ScrollEarlierButton"
                    MinWidth="32"
                    Padding="8,2"
                    Click="ScrollEarlier_Click"
                    Content="←"
                    ToolTipService.ToolTip="Scroll earlier" />
                <Button
                    x:Name="ZoomOutButton"
                    MinWidth="32"
                    Padding="8,2"
                    Click="ZoomOut_Click"
                    Content="−"
                    ToolTipService.ToolTip="Zoom out" />
                <TextBlock
                    x:Name="ZoomLabel"
                    MinWidth="48"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="1×"
                    TextAlignment="Center" />
                <Button
                    x:Name="ZoomInButton"
                    MinWidth="32"
                    Padding="8,2"
                    Click="ZoomIn_Click"
                    Content="+"
                    ToolTipService.ToolTip="Zoom in" />
                <Button
                    x:Name="ScrollLaterButton"
                    MinWidth="32"
                    Padding="8,2"
                    Click="ScrollLater_Click"
                    Content="→"
                    ToolTipService.ToolTip="Scroll later" />
            </StackPanel>
            <TextBlock
                x:Name="AudioHint"
                Foreground="#CCFFFFFF"
                FontSize="12"
                Text="Drag the audio track. Part volume is how loud that stretch is. 0% silences it, and 100% puts the original sound back. The picture stays. Click a marked part to put the sound back. Click empty audio to leave the last part as it is. Parts lists each stretch."
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="PartVolumeBar"
                Spacing="6"
                Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#CCFFFFFF"
                        Text="Part volume" />
                    <Slider
                        x:Name="PartVolumeSlider"
                        Grid.Column="1"
                        Maximum="200"
                        Minimum="0"
                        StepFrequency="1"
                        Value="0"
                        ValueChanged="PartVolumeSlider_ValueChanged" />
                    <TextBlock
                        x:Name="PartVolumeReadout"
                        Grid.Column="2"
                        MinWidth="44"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="White"
                        Text="0%" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button
                        MinWidth="72"
                        Padding="8,2"
                        Click="PartVolumePreset_Click"
                        Content="Silence"
                        Tag="0" />
                    <Button
                        MinWidth="56"
                        Padding="8,2"
                        Click="PartVolumePreset_Click"
                        Content="30%"
                        Tag="30" />
                    <Button
                        MinWidth="56"
                        Padding="8,2"
                        Click="PartVolumePreset_Click"
                        Content="150%"
                        Tag="150" />
                </StackPanel>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        x:Name="MuteButton"
                        x:FieldModifier="public"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Mute">
                        <FontIcon
                            x:Name="MuteIcon"
                            x:FieldModifier="public"
                            FontSize="16"
                            Glyph="&#xE767;" />
                    </Button>
                    <Slider
                        x:Name="VolumeSlider"
                        x:FieldModifier="public"
                        Width="96"
                        VerticalAlignment="Center"
                        Maximum="200"
                        Minimum="0"
                        StepFrequency="1"
                        ToolTipService.ToolTip="Volume. 100% is the usual level. Raise it up to 200% when a video is quiet."
                        Value="80" />
                    <TextBlock
                        x:Name="VolumeReadout"
                        MinWidth="42"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Volume percent"
                        FontSize="12"
                        Text="80%" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="BackButton"
                        x:FieldModifier="public"
                        Height="40"
                        MinWidth="76"
                        Padding="12,0"
                        ToolTipService.ToolTip="Back 10 seconds">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE100;" />
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="10" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PlayButton"
                        x:FieldModifier="public"
                        Width="44"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Play or pause">
                        <FontIcon
                            x:Name="PlayIcon"
                            x:FieldModifier="public"
                            FontSize="16"
                            Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        x:FieldModifier="public"
                        Height="40"
                        MinWidth="76"
                        Padding="12,0"
                        ToolTipService.ToolTip="Forward 10 seconds">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="10" />
                            <FontIcon FontSize="14" Glyph="&#xE101;" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="BookmarkButton"
                        x:FieldModifier="public"
                        Height="40"
                        Padding="12,0"
                        ToolTipService.ToolTip="Bookmark this moment"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8A4;" />
                            <TextBlock VerticalAlignment="Center" Text="Mark" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ToolsButton"
                        x:FieldModifier="public"
                        Height="40"
                        Padding="12,0"
                        AutomationProperties.Name="Tools"
                        ToolTipService.ToolTip="Tools"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE15E;" />
                            <TextBlock VerticalAlignment="Center" Text="Tools" />
                            <TextBlock
                                x:Name="ToolsExtra"
                                x:FieldModifier="public"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SnapshotButton"
                        x:FieldModifier="public"
                        Width="44"
                        Height="40"
                        Padding="0"
                        AutomationProperties.Name="Save this frame"
                        ToolTipService.ToolTip="Save this frame"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE722;" />
                    </Button>
                    <Button
                        x:Name="CopyFrameButton"
                        x:FieldModifier="public"
                        Width="44"
                        Height="40"
                        Padding="0"
                        AutomationProperties.Name="Copy this frame"
                        ToolTipService.ToolTip="Copy this frame"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        x:Name="SleepButton"
                        x:FieldModifier="public"
                        Height="40"
                        MinWidth="64"
                        Padding="10,0"
                        AutomationProperties.Name="Sleep timer"
                        ToolTipService.ToolTip="Sleep timer">
                        <TextBlock
                            x:Name="SleepLabel"
                            x:FieldModifier="public"
                            FontSize="13"
                            Text="Sleep" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Width="44"
                        Height="40"
                        Padding="0"
                        AutomationProperties.Name="Playback settings"
                        Click="Settings_Click"
                        ToolTipService.ToolTip="Playback settings">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                    <Button
                        x:Name="FullScreenButton"
                        x:FieldModifier="public"
                        Width="44"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Full screen">
                        <FontIcon
                            x:Name="FullScreenIcon"
                            x:FieldModifier="public"
                            FontSize="16"
                            Glyph="&#xE740;" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
        <Border
            x:Name="HoverCard"
            Width="168"
            Padding="4"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#F0161616"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel>
                <Border Height="90" Background="Black" CornerRadius="6">
                    <Image x:Name="HoverImage" Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    x:Name="HoverTime"
                    Margin="0,4,0,2"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    FontSize="12"
                    Text="0:00" />
            </StackPanel>
        </Border>
        <Popup
            x:Name="SettingsPopup"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsLightDismissEnabled="True"
            ShouldConstrainToRootBounds="True">
            <Border
                x:Name="SettingsCard"
                Width="360"
                Padding="0"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer
                    x:Name="SettingsScroll"
                    Padding="16"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="SettingsBackButton"
                            Height="32"
                            Padding="10,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Back to playback"
                            Click="SettingsBack_Click"
                            Content="Back"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SettingsTitle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Playback" />
                    </Grid>
                    <StackPanel x:Name="SettingsHome" Spacing="14">
                    <Button
                        x:Name="OpenLookButton"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Subtitle settings"
                        Click="OpenLook_Click"
                        ToolTipService.ToolTip="Size, color, background, position, and timing"
                        Visibility="Collapsed">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Text="Subtitle settings" />
                            <FontIcon HorizontalAlignment="Right" FontSize="12" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="OpenSoundButton"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Sound settings"
                        Click="OpenSound_Click"
                        ToolTipService.ToolTip="Bass, voice, treble, and even volume"
                        Visibility="Collapsed">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Text="Sound" />
                            <FontIcon HorizontalAlignment="Right" FontSize="12" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                    <StackPanel x:Name="QualityRow" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Quality" />
                        <ComboBox
                            x:Name="QualityCombo"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Quality"
                            SelectionChanged="QualityCombo_Changed"
                            ToolTipService.ToolTip="Video quality" />
                    </StackPanel>
                    <StackPanel x:Name="AudioRow" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Audio" />
                        <ComboBox
                            x:Name="AudioCombo"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Audio"
                            SelectionChanged="AudioCombo_Changed"
                            ToolTipService.ToolTip="Audio language" />
                    </StackPanel>
                    <StackPanel x:Name="CaptionRow" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Captions" />
                        <ComboBox
                            x:Name="CaptionCombo"
                            HorizontalAlignment="Stretch"
                            MaxDropDownHeight="320"
                            PlaceholderText="Captions"
                            SelectionChanged="CaptionCombo_Changed"
                            ToolTipService.ToolTip="Captions"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="SubtitleButton"
                            Height="36"
                            Padding="12,0"
                            HorizontalAlignment="Left"
                            Click="Subtitle_Click"
                            ToolTipService.ToolTip="Show subtitles"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="SubtitleIcon" FontSize="14" Glyph="&#xE7F0;" />
                                <TextBlock x:Name="SubtitleText" VerticalAlignment="Center" Text="CC" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ExportCaptionsButton"
                            Height="36"
                            Padding="12,0"
                            HorizontalAlignment="Left"
                            Click="ExportCaptions_Click"
                            Content="Export"
                            ToolTipService.ToolTip="Save these captions as an SRT file"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="SpeedRow" Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Speed" />
                        <ComboBox
                            x:Name="SpeedCombo"
                            x:FieldModifier="public"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="3"
                            ToolTipService.ToolTip="Playback speed">
                            <ComboBoxItem Content="0.25×" Tag="0.25" />
                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                            <ComboBoxItem Content="0.75×" Tag="0.75" />
                            <ComboBoxItem Content="1×" Tag="1" />
                            <ComboBoxItem Content="1.25×" Tag="1.25" />
                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                            <ComboBoxItem Content="1.75×" Tag="1.75" />
                            <ComboBoxItem Content="2×" Tag="2" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="RepeatButtons" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            x:Name="RepeatHint"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Repeat a section"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RepeatAButton"
                                Height="36"
                                Padding="12,0"
                                Click="RepeatA_Click"
                                ToolTipService.ToolTip="Mark where the repeat starts">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="A" />
                                    <TextBlock VerticalAlignment="Center" Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="RepeatBButton"
                                Height="36"
                                Padding="12,0"
                                Click="RepeatB_Click"
                                ToolTipService.ToolTip="Mark where the repeat ends">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="B" />
                                    <TextBlock VerticalAlignment="Center" Text="End" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="RepeatClearButton"
                                Height="36"
                                Padding="12,0"
                                Click="RepeatClear_Click"
                                Content="Clear"
                                ToolTipService.ToolTip="Clear the repeat points"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="LookPage" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Subtitle sync" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Move the words earlier or later when they do not match the voice."
                            TextWrapping="Wrap" />
                        <Grid>
                            <Button
                                x:Name="DelayEarlierButton"
                                Height="36"
                                Padding="12,0"
                                HorizontalAlignment="Left"
                                Click="DelayEarlier_Click"
                                Content="Earlier"
                                ToolTipService.ToolTip="Show the words 0.5 seconds sooner" />
                            <TextBlock
                                x:Name="DelayText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="In sync"
                                ToolTipService.ToolTip="Sooner is to the left. Later is to the right." />
                            <Button
                                x:Name="DelayLaterButton"
                                Height="36"
                                Padding="12,0"
                                HorizontalAlignment="Right"
                                Click="DelayLater_Click"
                                Content="Later"
                                ToolTipService.ToolTip="Show the words 0.5 seconds later" />
                        </Grid>
                        <Slider
                            x:Name="DelaySlider"
                            AutomationProperties.Name="Subtitle delay"
                            LargeChange="0.5"
                            Maximum="15"
                            Minimum="-15"
                            SmallChange="0.1"
                            StepFrequency="0.1"
                            ToolTipService.ToolTip="Drag left to show the words sooner. Drag right to show them later." />
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Size" />
                            <TextBlock
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Color" />
                            <ComboBox
                                x:Name="CaptionSizeCombo"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Subtitle size"
                                ToolTipService.ToolTip="Subtitle size">
                                <ComboBoxItem Content="Small" />
                                <ComboBoxItem Content="Medium" />
                                <ComboBoxItem Content="Large" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CaptionColorCombo"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Subtitle color"
                                ToolTipService.ToolTip="Subtitle color">
                                <ComboBoxItem Content="White" />
                                <ComboBoxItem Content="Yellow" />
                                <ComboBoxItem Content="Cyan" />
                                <ComboBoxItem Content="Green" />
                                <ComboBoxItem Content="Black" />
                            </ComboBox>
                            <TextBlock
                                Grid.Row="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Background" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Position" />
                            <ComboBox
                                x:Name="CaptionPlateCombo"
                                Grid.Row="3"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Subtitle background"
                                ToolTipService.ToolTip="Subtitle background">
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="None" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CaptionSpotCombo"
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Subtitle position"
                                ToolTipService.ToolTip="Subtitle position">
                                <ComboBoxItem Content="Bottom" />
                                <ComboBoxItem Content="Middle" />
                                <ComboBoxItem Content="Top" />
                            </ComboBox>
                        </Grid>
                        <Button
                            x:Name="ResetLookButton"
                            Height="36"
                            Padding="12,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Reset subtitles"
                            Click="ResetLook_Click"
                            Content="Reset"
                            ToolTipService.ToolTip="Restore subtitle size, color, background, position, and timing" />
                    </StackPanel>
                    <StackPanel x:Name="SoundPage" Spacing="10" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Shape the sound while this plays. A change continues from the same moment, and the file stays as it is."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="SoundOffButton"
                                Height="36"
                                MinWidth="72"
                                Padding="12,0"
                                AutomationProperties.Name="Sound off"
                                Click="SoundPreset_Click"
                                Content="Off"
                                Tag="Flat"
                                ToolTipService.ToolTip="Play the sound without an equalizer" />
                            <Button
                                x:Name="SoundBassButton"
                                Height="36"
                                MinWidth="72"
                                Padding="12,0"
                                AutomationProperties.Name="Bass"
                                Click="SoundPreset_Click"
                                Content="Bass"
                                Tag="Bass"
                                ToolTipService.ToolTip="Boost the low sound" />
                            <Button
                                x:Name="SoundVoiceButton"
                                Height="36"
                                MinWidth="72"
                                Padding="12,0"
                                AutomationProperties.Name="Voice"
                                Click="SoundPreset_Click"
                                Content="Voice"
                                Tag="Voice"
                                ToolTipService.ToolTip="Bring voices forward" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="SoundTrebleButton"
                                Height="36"
                                MinWidth="72"
                                Padding="12,0"
                                AutomationProperties.Name="Treble"
                                Click="SoundPreset_Click"
                                Content="Treble"
                                Tag="Treble"
                                ToolTipService.ToolTip="Boost the high sound" />
                            <Button
                                x:Name="SoundCustomButton"
                                Height="36"
                                MinWidth="84"
                                Padding="12,0"
                                AutomationProperties.Name="Custom"
                                Click="SoundPreset_Click"
                                Content="Custom"
                                Tag="Custom"
                                ToolTipService.ToolTip="Set bass, voice, and treble yourself" />
                        </StackPanel>
                        <StackPanel x:Name="CustomBands" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="BassGainText" Text="Bass  0 dB" />
                            <Slider
                                x:Name="BassSlider"
                                AutomationProperties.Name="Bass amount"
                                LargeChange="3"
                                Maximum="12"
                                Minimum="-12"
                                SmallChange="1"
                                StepFrequency="1"
                                ToolTipService.ToolTip="Low sound, from -12 dB to +12 dB" />
                            <TextBlock x:Name="VoiceGainText" Text="Voice  0 dB" />
                            <Slider
                                x:Name="VoiceSlider"
                                AutomationProperties.Name="Voice amount"
                                LargeChange="3"
                                Maximum="12"
                                Minimum="-12"
                                SmallChange="1"
                                StepFrequency="1"
                                ToolTipService.ToolTip="Voice, from -12 dB to +12 dB" />
                            <TextBlock x:Name="TrebleGainText" Text="Treble  0 dB" />
                            <Slider
                                x:Name="TrebleSlider"
                                AutomationProperties.Name="Treble amount"
                                LargeChange="3"
                                Maximum="12"
                                Minimum="-12"
                                SmallChange="1"
                                StepFrequency="1"
                                ToolTipService.ToolTip="High sound, from -12 dB to +12 dB" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="NormalizeSwitch"
                            AutomationProperties.Name="Normalize volume"
                            Header="Normalize volume"
                            OffContent=""
                            OnContent="" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Quiet videos come up and loud videos come down."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ResetSoundButton"
                            Height="36"
                            Padding="12,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Reset sound"
                            Click="ResetSound_Click"
                            Content="Reset"
                            ToolTipService.ToolTip="Turn the equalizer off and stop normalization. The volume slider stays where you set it." />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
