<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.MediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PersonalMediaPlayer.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="220"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>

    <Grid PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
        <Border
            Padding="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="148" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12,12,0,0">
                    <Grid>
                        <Image x:Name="ThumbImage" Stretch="UniformToFill" />
                        <Border
                            Background="#66000000"
                            Visibility="{x:Bind Item.IsVideo, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="32"
                                Foreground="White"
                                Glyph="&#xE768;" />
                        </Border>
                        <Border
                            x:Name="DurationBadge"
                            Margin="8"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#CC000000"
                            CornerRadius="4"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="DurationText"
                                Foreground="White"
                                FontSize="12" />
                        </Border>
                        <Button
                            x:Name="FavoriteButton"
                            Width="32"
                            Height="32"
                            Margin="8"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#CC000000"
                            Click="Favorite_Click"
                            CornerRadius="16"
                            Visibility="Collapsed">
                            <FontIcon
                                x:Name="FavoriteIcon"
                                FontSize="14"
                                Foreground="White"
                                Glyph="&#xEB51;" />
                        </Button>
                        <Border
                            x:Name="SelectionMark"
                            Width="26"
                            Height="26"
                            Margin="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="13"
                            Visibility="Collapsed">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Glyph="&#xE73E;" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Item.DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ImportedOn, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
