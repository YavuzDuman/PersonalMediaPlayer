<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.PlaylistPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PersonalMediaPlayer.App.Controls"
    VerticalAlignment="Stretch">
    <Grid>
        <StackPanel x:Name="ThemeInk" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="PrimaryInk" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SecondaryInk" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="HoverInk" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="LineInk" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="AccentInk" Background="{ThemeResource AccentFillColorDefaultBrush}" />
        </StackPanel>

        <Border
            x:Name="Rail"
            Padding="10,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Tapped="Rail_Tapped"
            ToolTipService.ToolTip="Show playlist"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="3" VerticalAlignment="Stretch" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                <Border
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE93F;" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="RailName"
                        MaxWidth="168"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="RailCount"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="Panel"
            Width="340"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        x:Name="PlaylistName"
                        Margin="0,0,44,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Collapse_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Hide playlist">
                        <FontIcon FontSize="14" Glyph="&#xE76C;" />
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock
                        x:Name="PositionText"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="WatchedText"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <CheckBox
                        x:Name="UnwatchedBox"
                        Margin="0,4,0,0"
                        Checked="Unwatched_Changed"
                        Content="Unwatched only"
                        Unchecked="Unwatched_Changed" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="8">
                    <controls:WrapBar Spacing="8">
                        <Button x:Name="PreviousButton" Click="Previous_Click" Content="Previous" Style="{StaticResource ActionButtonStyle}" />
                        <Button x:Name="NextButton" Click="Next_Click" Content="Next" Style="{StaticResource ActionButtonStyle}" />
                    </controls:WrapBar>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ShuffleButton" MinWidth="0" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Shuffle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                                <TextBlock x:Name="ShuffleLabel" Text="Shuffle" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RepeatButton" Grid.Column="1" MinWidth="0" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Repeat_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="RepeatIcon" FontSize="14" Glyph="&#xE1CD;" />
                                <TextBlock x:Name="RepeatLabel" Text="Repeat off" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="ModeLine"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Saved order. Repeat is off."
                        TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox x:Name="PlayNextBox" Grid.Row="3" Checked="PlayNext_Changed" Unchecked="PlayNext_Changed">
                    <TextBlock Text="Play the next video when this one ends" TextWrapping="Wrap" />
                </CheckBox>
                <InfoBar
                    x:Name="Status"
                    Grid.Row="4"
                    IsClosable="True"
                    IsOpen="False"
                    Visibility="Collapsed" />
                <Grid Grid.Row="5">
                    <TextBlock
                        x:Name="Empty"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ScrollViewer
                        x:Name="Scroller"
                        AllowDrop="True"
                        DragOver="Scroller_DragOver"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="List" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
