<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.PlaylistPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Stretch">
    <Grid>
        <StackPanel x:Name="ThemeInk" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="PrimaryInk" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SecondaryInk" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="HoverInk" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="LineInk" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="AccentInk" Background="{ThemeResource AccentFillColorDefaultBrush}" />
        </StackPanel>

        <Border
            x:Name="Rail"
            Width="44"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Tapped="Rail_Tapped"
            ToolTipService.ToolTip="Show playlist"
            Visibility="Collapsed">
            <FontIcon
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Glyph="&#xE93F;" />
        </Border>

        <Border
            x:Name="Panel"
            Width="300"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        x:Name="PlaylistName"
                        Margin="0,0,36,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Collapse_Click"
                        ToolTipService.ToolTip="Hide playlist">
                        <FontIcon FontSize="12" Glyph="&#xE76C;" />
                    </Button>
                </Grid>
                <TextBlock
                    x:Name="PositionText"
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PreviousButton" Click="Previous_Click" Content="Previous" />
                    <Button x:Name="NextButton" Click="Next_Click" Content="Next" />
                </StackPanel>
                <CheckBox x:Name="PlayNextBox" Grid.Row="3" Checked="PlayNext_Changed" Unchecked="PlayNext_Changed">
                    <TextBlock Text="Play the next video when this one ends" TextWrapping="Wrap" />
                </CheckBox>
                <InfoBar
                    x:Name="Status"
                    Grid.Row="4"
                    IsClosable="True"
                    IsOpen="False"
                    Visibility="Collapsed" />
                <Grid Grid.Row="5">
                    <TextBlock
                        x:Name="Empty"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="List" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
