<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.QueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Stretch">
    <Grid>
        <StackPanel x:Name="ThemeInk" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="PrimaryInk" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SecondaryInk" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="LineInk" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="AccentInk" Background="{ThemeResource AccentFillColorDefaultBrush}" />
        </StackPanel>
        <Border
            Width="300"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Queue" />
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock
                        x:Name="CountText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="0 videos" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Drag a row to reorder. These play before shuffle and repeat."
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="NextButton"
                            Click="Next_Click"
                            Content="Next"
                            ToolTipService.ToolTip="Play the next queued video" />
                        <Button
                            x:Name="ClearButton"
                            Click="Clear_Click"
                            Content="Clear"
                            ToolTipService.ToolTip="Remove every waiting video. The current video keeps playing." />
                    </StackPanel>
                    <InfoBar
                        x:Name="Status"
                        IsClosable="True"
                        IsOpen="False"
                        Visibility="Collapsed" />
                </StackPanel>
                <ScrollViewer
                    x:Name="Scroller"
                    Grid.Row="3"
                    AllowDrop="True"
                    DragOver="Scroller_DragOver"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Rows" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
