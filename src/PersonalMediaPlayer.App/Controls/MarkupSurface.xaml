<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.MarkupSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="Black" CornerRadius="16">
            <ScrollViewer
                x:Name="PreviewScroll"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                MinZoomFactor="1"
                MaxZoomFactor="8"
                PointerWheelChanged="PreviewScroll_PointerWheelChanged"
                SizeChanged="PreviewScroll_SizeChanged"
                Tapped="PreviewScroll_Tapped"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ZoomMode="Disabled">
                <Grid
                    x:Name="PreviewHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Image
                        x:Name="PreviewImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Stretch="Fill" />
                    <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False" />
                    <Canvas
                        x:Name="AnnotationCanvas"
                        Background="Transparent"
                        PointerExited="Canvas_PointerExited"
                        PointerMoved="Canvas_PointerMoved"
                        PointerPressed="Canvas_PointerPressed"
                        PointerReleased="Canvas_PointerReleased" />
                    <Canvas x:Name="CursorCanvas" IsHitTestVisible="False">
                        <Ellipse
                            x:Name="EraserCursor"
                            Fill="#40FFFFFF"
                            Stroke="White"
                            StrokeThickness="1.5"
                            Visibility="Collapsed" />
                    </Canvas>
                    <Grid
                        x:Name="CompareLayer"
                        Background="Transparent"
                        PointerCanceled="Compare_PointerReleased"
                        PointerMoved="Compare_PointerMoved"
                        PointerPressed="Compare_PointerPressed"
                        PointerReleased="Compare_PointerReleased"
                        Visibility="Collapsed">
                        <Canvas x:Name="CompareAfterCanvas" IsHitTestVisible="False">
                            <Image x:Name="CompareAfterImage" Stretch="Fill" />
                        </Canvas>
                        <Grid x:Name="CompareBeforeHost" IsHitTestVisible="False">
                            <Canvas x:Name="CompareBeforeCanvas">
                                <Image x:Name="CompareBeforeImage" Stretch="Fill" />
                            </Canvas>
                        </Grid>
                        <Grid IsHitTestVisible="False">
                            <Border
                                Margin="12"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#CC000000"
                                CornerRadius="8">
                                <TextBlock Foreground="White" FontSize="12" Text="Before" />
                            </Border>
                            <Border
                                Margin="12"
                                Padding="8,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#CC000000"
                                CornerRadius="8">
                                <TextBlock Foreground="White" FontSize="12" Text="After" />
                            </Border>
                        </Grid>
                        <Canvas x:Name="CompareChrome" IsHitTestVisible="False">
                            <Border x:Name="CompareDivider" Width="2" Background="White" />
                            <Border
                                x:Name="CompareHandle"
                                Width="36"
                                Height="36"
                                Background="#CC161616"
                                BorderBrush="White"
                                BorderThickness="2"
                                CornerRadius="18">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    FontSize="14"
                                    Text="||" />
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Row="1"
            Padding="12,10"
            Background="#CC161616"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel Spacing="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" Visibility="{x:Bind ToolBarVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Width="36" Height="36" Click="ToolNone_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Zoom">
                            <FontIcon FontSize="16" Glyph="&#xE8A3;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolRead_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Read text in an area">
                            <FontIcon FontSize="16" Glyph="&#xE8C1;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolPen_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Pen">
                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolHighlight_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Highlight">
                            <FontIcon FontSize="16" Glyph="&#xE7E6;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolEraser_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Eraser">
                            <FontIcon FontSize="16" Glyph="&#xE75C;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolArrow_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Arrow">
                            <FontIcon FontSize="16" Glyph="&#xE72A;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolRect_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Rectangle">
                            <FontIcon FontSize="16" Glyph="&#xE739;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolText_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Text">
                            <FontIcon FontSize="16" Glyph="&#xE8D2;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolStep_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Step number">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="1" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolBlur_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Blur private area">
                            <FontIcon FontSize="16" Glyph="&#xE71C;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolRedact_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Redact with a solid color">
                            <FontIcon FontSize="16" Glyph="&#xE73E;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ToolCrop_Click" CornerRadius="8" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Trim">
                            <FontIcon FontSize="16" Glyph="&#xE7A8;" />
                        </Button>
                        <Button Width="36" Height="36" Click="Undo_Click" CornerRadius="8" IsEnabled="{x:Bind CanUndo, Mode=OneWay}" ToolTipService.ToolTip="Undo">
                            <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                        </Button>
                        <Button Width="36" Height="36" Click="Redo_Click" CornerRadius="8" IsEnabled="{x:Bind CanRedo, Mode=OneWay}" ToolTipService.ToolTip="Redo">
                            <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                        </Button>
                        <Button Width="36" Height="36" Click="ClearMarks_Click" CornerRadius="8" IsEnabled="{x:Bind CanClearMarks, Mode=OneWay}" ToolTipService.ToolTip="Erase all marks">
                            <FontIcon FontSize="16" Glyph="&#xE894;" />
                        </Button>
                        <Border Width="1" Height="24" Margin="4,0" VerticalAlignment="Center" Background="#33FFFFFF" />
                        <Border Width="22" Height="22" VerticalAlignment="Center" Background="#E81123" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="4" Tag="E81123" Tapped="Color_Tapped" />
                        <Border Width="22" Height="22" VerticalAlignment="Center" Background="#FF8C00" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="4" Tag="FF8C00" Tapped="Color_Tapped" />
                        <Border Width="22" Height="22" VerticalAlignment="Center" Background="#F7D417" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="4" Tag="F7D417" Tapped="Color_Tapped" />
                        <Border Width="22" Height="22" VerticalAlignment="Center" Background="#16C60C" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="4" Tag="16C60C" Tapped="Color_Tapped" />
                        <Border Width="22" Height="22" VerticalAlignment="Center" Background="#0078D4" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="4" Tag="0078D4" Tapped="Color_Tapped" />
                        <Border Width="22" Height="22" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="4" Tag="FFFFFF" Tapped="Color_Tapped" />
                        <Border Width="22" Height="22" VerticalAlignment="Center" Background="#111111" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="4" Tag="111111" Tapped="Color_Tapped" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind StrokeSizeVisibility, Mode=OneWay}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="{x:Bind StrokeSizeLabel, Mode=OneWay}" />
                    <Slider
                        Width="180"
                        VerticalAlignment="Center"
                        Maximum="12"
                        Minimum="1"
                        StepFrequency="1"
                        Value="{x:Bind StrokeSize, Mode=TwoWay}" />
                </StackPanel>
                <Grid ColumnSpacing="12" Visibility="{x:Bind CompareBarVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="White" Text="Before" />
                    <Slider
                        Grid.Column="1"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="0.1"
                        Value="{x:Bind ComparePercent, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="White" Text="After" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
