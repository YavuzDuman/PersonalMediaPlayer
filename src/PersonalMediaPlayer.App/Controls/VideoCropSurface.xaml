<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.VideoCropSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Canvas x:Name="Host" PointerMoved="Host_Moved" PointerReleased="Host_Released" PointerCanceled="Host_Released">
        <Border x:Name="ShadeTop" Background="#99000000" IsHitTestVisible="False" />
        <Border x:Name="ShadeBottom" Background="#99000000" IsHitTestVisible="False" />
        <Border x:Name="ShadeLeft" Background="#99000000" IsHitTestVisible="False" />
        <Border x:Name="ShadeRight" Background="#99000000" IsHitTestVisible="False" />
        <Border
            x:Name="Frame"
            BorderBrush="White"
            BorderThickness="2"
            PointerPressed="Frame_Pressed">
            <Grid>
                <Border x:Name="HandleNW" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" Margin="-7" />
                <Border x:Name="HandleNE" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" Margin="-7" />
                <Border x:Name="HandleSW" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="White" Margin="-7" />
                <Border x:Name="HandleSE" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="White" Margin="-7" />
            </Grid>
        </Border>
    </Canvas>
</UserControl>
