<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PersonalMediaPlayer.App.Controls.PlaylistHomeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="220">
    <Border
        x:Name="Root"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Tapped="Root_Tapped">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="124" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12,12,0,0" />
                <FontIcon
                    x:Name="EmptyMark"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="28"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE93F;"
                    IsHitTestVisible="False" />
                <Grid x:Name="Mosaic" IsHitTestVisible="False" />
                <Border
                    x:Name="PlayShade"
                    Width="44"
                    Height="44"
                    Margin="0,0,4,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#99000000"
                    CornerRadius="22"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
                <Button
                    x:Name="PlayButton"
                    Margin="0,0,8,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="Play_Click"
                    Style="{StaticResource IconAccentButtonStyle}"
                    ToolTipService.ToolTip="Play"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE768;"
                        IsHitTestVisible="False" />
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="2">
                <TextBlock
                    x:Name="Title"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="Count"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
